generator client {
  provider     = "prisma-client"
  output       = "../src/generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
}

enum TicketPriority {
  URGENT
  HIGH
  MEDIUM
  LOW
}

enum UserRole {
  USER
  TECHNICIAN
}

enum TicketEventAuthor {
  REQUESTER
  AGENT
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  handle    String?  @unique
  role      UserRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@map("users")
}

enum ClientPlan {
  STARTER
  PRO
  EMPRESA
}

model Client {
  id        String     @id @default(uuid())
  name      String
  company   String?
  plan      ClientPlan
  email     String     @unique
  phone     String?
  tags      String[]   @default([])
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([plan])
  @@index([name])
  @@map("clients")
}

model Ticket {
  id             Int            @id @default(autoincrement())
  subject        String
  status         TicketStatus
  priority       TicketPriority
  agentId        String?
  category       String
  requesterName  String
  requesterEmail String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  events         TicketEvent[]

  @@index([status])
  @@index([priority])
  @@index([agentId])
  @@map("tickets")
}

model TicketEvent {
  id                String            @id @default(uuid())
  ticketId          Int
  ticket            Ticket            @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  occurredAt        DateTime          @default(now())
  text              String
  isInternalNote    Boolean           @default(false)
  author            TicketEventAuthor @default(REQUESTER)
  deletedAt         DateTime?
  editedAt          DateTime?
  pinnedAt          DateTime?
  replyToId         String?
  forwardedFromName String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([ticketId])
  @@map("ticket_events")
}

model KnowledgeArticle {
  id             String   @id @default(uuid())
  title          String
  category       String
  body           String
  tags           String[] @default([])
  published      Boolean  @default(false)
  authorName     String
  views          Int      @default(0)
  usefulPercent  Int      @default(0)
  ticketsAvoided Int      @default(0)
  sourceTicketId Int?     @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([category])
  @@index([published])
  @@map("knowledge_articles")
}

enum TeamChatKind {
  CHANNEL
  DIRECT
}

model TeamChat {
  id        String            @id @default(uuid())
  name      String
  kind      TeamChatKind      @default(CHANNEL)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  messages  TeamChatMessage[]

  @@map("team_chats")
}

model TeamChatMessage {
  id                String    @id @default(uuid())
  chatId            String
  chat              TeamChat  @relation(fields: [chatId], references: [id], onDelete: Cascade)
  occurredAt        DateTime  @default(now())
  text              String
  authorHandle      String
  authorName        String
  deletedAt         DateTime?
  editedAt          DateTime?
  pinnedAt          DateTime?
  replyToId         String?
  forwardedFromName String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([chatId])
  @@map("team_chat_messages")
}

model Notification {
  id              String    @id @default(uuid())
  recipientHandle String
  type            String
  title           String
  body            String
  ticketId        Int?
  readAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([recipientHandle, createdAt])
  @@index([recipientHandle, readAt])
  @@map("notifications")
}

model NotificationPreference {
  id              String   @id @default(uuid())
  recipientHandle String   @unique
  assigned        Boolean  @default(true)
  sla             Boolean  @default(true)
  digest          Boolean  @default(false)
  sound           Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("notification_preferences")
}

model AutomationRule {
  id          String    @id @default(uuid())
  name        String
  trigger     String
  condition   String
  action      String
  enabled     Boolean   @default(true)
  authorName  String
  runCount    Int       @default(0)
  lastRunAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([enabled])
  @@map("automation_rules")
}

model SlaPolicy {
  id                 String         @id @default(uuid())
  priority           TicketPriority @unique
  responseMinutes    Int
  resolutionMinutes  Int
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@map("sla_policies")
}

model CannedResponse {
  id        String   @id @default(uuid())
  title     String
  category  String
  shortcut  String   @unique
  body      String
  useCount  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@map("canned_responses")
}

model RoutingRule {
  id          String   @id @default(uuid())
  name        String
  keywords    String[]
  category    String
  agentHandle String?
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled])
  @@index([category])
  @@map("routing_rules")
}

enum AiChatRole {
  USER
  ASSISTANT
}

model AiChatSession {
  id          String          @id @default(uuid())
  title       String
  ownerHandle String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  messages    AiChatMessage[]

  @@index([ownerHandle, updatedAt])
  @@map("ai_chat_sessions")
}

model AiChatMessage {
  id        String        @id @default(uuid())
  sessionId String
  session   AiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      AiChatRole
  content   String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([sessionId, createdAt])
  @@map("ai_chat_messages")
}
